# Context AI Hub v2.34 - one environment template
#
# 1) Copy to .env only on the machine that runs Hub.
# 2) Put real secrets only in .env. Git ignores .env.
# 3) CI/CD uses the same variable names through GitHub Actions Secrets/Variables.
# 4) Advanced performance defaults live in application.yml / ai-service code, not here.

# -----------------------------------------------------------------------------
# Web / local runtime
# -----------------------------------------------------------------------------
HUB_PORT=8080
HUB_BIND_ADDRESS=localhost
HUB_STORAGE_ROOT=./data/storage
HUB_AI_BASE_URL=https://yellow.it.kr
HUB_LOCAL_AUTO_OPEN=true

# Set 0.0.0.0 only when other intranet PCs must reach this machine.
# For browser microphone recording on another intranet PC, HTTPS is recommended.
HUB_LAN_HOST=

# Real public domain, only for the compose --profile https (Caddy) deployment. Caddy automatically
# gets/renews a Let's Encrypt certificate for this domain - DNS must already point here and ports
# 80/443 must be reachable from the internet. Leave blank if you are not using that profile.
HUB_TLS_DOMAIN=

# -----------------------------------------------------------------------------
# Login / security - never commit real values
# -----------------------------------------------------------------------------
# Random string, 32+ chars. Generate with: openssl rand -base64 48
HUB_JWT_SECRET=
# true once Hub is reachable over HTTPS (any public/real-domain deployment) - login cookies are
# otherwise sent over plain HTTP. Keep false only for plain-HTTP localhost/LAN-only use.
HUB_COOKIE_SECURE=false

# true refuses to start on a weak/placeholder HUB_JWT_SECRET or with HUB_COOKIE_SECURE=false -
# recommended true for any public/real-domain deployment, once the values above are actually set.
HUB_ENFORCE_SECURE_CONFIG=false

# Admin signup never self-approves, so a fresh install with zero admins has no way to get one through
# the app itself. Set this (12+ chars, letters+numbers) ONLY here in your own untracked .env - never
# commit a real value - and BootstrapService creates exactly one admin from it on next startup, forced
# to change its password on first login. Leave blank once that first admin exists; it is a no-op then.
HUB_BOOTSTRAP_ADMIN_LOGIN_ID=admin
HUB_BOOTSTRAP_ADMIN_PASSWORD=

# Secret key used to one-way hash resident-registration/card/phone numbers and emails found in
# meeting STT transcripts before they are stored or searched. Set your own long random value here;
# without it, Hub generates a random key at every restart and previously redacted values will no
# longer match. Keep it out of version control, the same as the other secrets in this file.
# Generate with: openssl rand -base64 32
HUB_STT_PII_HASH_KEY=

# -----------------------------------------------------------------------------
# AI
# Real implementation: Gemini LLM/STT + local E5 + local PaddleOCR for uploaded scans/images.
# No .env file => HUB.bat start falls back to mock/hash for a quick smoke run.
# -----------------------------------------------------------------------------
HUB_AI_MODE=gemini
GEMINI_API_KEY=GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
HUB_EMBED_MODE=e5


# -----------------------------------------------------------------------------
# PostgreSQL - only for compose.yml / larger intranet installation.
# Normal HUB.bat start uses H2 and does not require these values.
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/hub
DB_USER=hub
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Read-only external connectors - fill only the services you enable.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=HUB_TOKEN
GITHUB_CLIENT_ID=HUB_CLIENT_ID
GITHUB_CLIENT_SECRET=HUB_CLIENT_SECRE
SLACK_TOKEN=SLACK_TOKEN
SLACK_CLIENT_ID=SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=SLACK_CLIENT_SECRET
# Slack workspace ID used to open the login page directly for this workspace.
SLACK_TEAM_ID=SLACK_TEAM_ID
NOTION_TOKEN=NOTION_TOKEN
NOTION_CLIENT_ID=NOTION_CLIENT_ID
NOTION_CLIENT_SECRET=NOTION_CLIENT_SECRET
# 브라우저가 Hub에 접속하는 주소. OAuth 콜백 주소를 이 값으로 고정합니다.
# 비워두면 접속한 주소를 그대로 사용합니다. 로컬 실행 주소는 localhost로 통일합니다.
# 공인 도메인으로 서비스할 때는 반드시 채우기. 예: HUB_PUBLIC_BASE_URL=https://yellow.it.kr
HUB_PUBLIC_BASE_URL=https://yellow.it.kr

GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=GOOGLE_REFRESH_TOKEN
# Usually keep this blank. Hub can refresh a short-lived access token itself.
GOOGLE_ACCESS_TOKEN=GOOGLE_ACCESS_TOKEN
# Off by default: a token above (or GITHUB_TOKEN/SLACK_TOKEN/NOTION_TOKEN) is only ever used by the
# account that linked it. Set to true only for a single-tenant demo where every user should share
# that one token/account instead of linking their own - never on a server with real, separate users.
HUB_ALLOW_SHARED_CONNECTOR_FALLBACK=false
